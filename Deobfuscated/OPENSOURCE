	TweenService:Create(toastStroke, TweenInfo.new(0.18), { Transparency = 0.25 }):Play()
	task.delay(1.8, function()
		if not toast.Visible then return end
		local t = TweenService:Create(toast, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
			Position = UDim2.new(0.5, -95, 0, -35),
			BackgroundTransparency = 1,
		})
		TweenService:Create(toastText, TweenInfo.new(0.22), { TextTransparency = 1 }):Play()
		TweenService:Create(toastStroke, TweenInfo.new(0.22), { Transparency = 1 }):Play()
		t:Play()
		t.Completed:Connect(function()
			if toast.Position.Y.Offset <= -25 then toast.Visible = false end
		end)
	end)
end

