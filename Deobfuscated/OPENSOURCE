util.startEggProtection = function(uid)
	if not uid or not remotes.AskFieldEggCarry then return end
	if state.isProtecting and state.heldEggUid == uid then return end
	state.isProtecting = true
	state.heldEggUid = uid
	task.spawn(function()
		while state.isProtecting and state.heldEggUid == uid do
			local ok, result = pcall(function()
				return remotes.AskFieldEggCarry:InvokeServer({ Uid = uid })
			end)
			if ok and result == true then state.carrying = true end
			task.wait(CFG.PROTECT_INTERVAL)
		end
	end)
end

