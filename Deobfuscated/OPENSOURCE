util.tweenToTarget = function(targetPos, faceForward)
	local char = localPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp then return end
	if util.isPlayerInGroundArea(hrp) then util.unequipTreadmill() end
	local speed = CFG.TWEEN_SPEED or 500
	util.stopCurrentTween(false)
	if hum then
		if hum.WalkSpeed > 0 then savedWalkSpeed = hum.WalkSpeed end
		hum.WalkSpeed = 0
	end
	local function moveTo(pos, onDone)
		local dist = (pos - hrp.Position).Magnitude
		if dist < 2 then
			if onDone then onDone() end
			return
		end
		local cf = CFrame.new(pos)
		if faceForward then
			local look = Vector3.new(pos.X - hrp.Position.X, 0, pos.Z - hrp.Position.Z)
			if look.Magnitude > 0.01 then
				cf = CFrame.lookAt(pos, pos + look.Unit)
			end
		end
		local tween = TweenService:Create(hrp, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), { CFrame = cf })
		activeTween = tween
		tweenConn = tween.Completed:Connect(function(ps)
			if activeTween == tween then
				activeTween = nil
				if tweenConn then tweenConn:Disconnect() tweenConn = nil end
				if ps == Enum.PlaybackState.Completed then
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
					hrp.CFrame = cf
					if onDone then onDone() end
				end
			end
		end)
		tween:Play()
	end
	local dest = faceForward and targetPos or util.getGroundAdjustedPosition(targetPos)
	local waypoint = CFG.WAYPOINT
	local nearWp = (targetPos - waypoint).Magnitude < 2
	if CFG.USE_GROUND_DETECTION and not faceForward and util.isPlayerInGroundArea(hrp) and not nearWp then
		moveTo(util.getGroundAdjustedPosition(waypoint), function()
			moveTo(dest, util.completeMove)
		end)
	else
		moveTo(dest, util.completeMove)
	end
end

