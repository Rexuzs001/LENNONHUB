util.isPlayerInGroundArea = function(hrp)
	local ground = getGround()
	if not ground or not hrp then return false end
	if ground:IsA("Model") then
		local bb, size = ground:GetBoundingBox()
		local lp = bb:PointToObjectSpace(hrp.Position)
		return math.abs(lp.X) <= size.X / 2 and math.abs(lp.Y) <= size.Y / 2 + 20 and math.abs(lp.Z) <= size.Z / 2
	end
	if ground:IsA("BasePart") then
		local lp = ground.CFrame:PointToObjectSpace(hrp.Position)
		return math.abs(lp.X) <= ground.Size.X / 2 and math.abs(lp.Y) <= ground.Size.Y / 2 + 20 and math.abs(lp.Z) <= ground.Size.Z / 2
	end
	return false
end

