util.refreshEggs = function(force)
	local now = tick()
	if not force and now - state.lastRefresh < CFG.REFRESH_INTERVAL then return state.eggs end
	if not remotes.AskFieldEggSnapshot then return state.eggs end
	local ok, result = pcall(function()
		return remotes.AskFieldEggSnapshot:InvokeServer()
	end)
	if not ok or not result then return state.eggs end
	local eggs = state.eggs
	table.clear(eggs)
	if result.Records then
		for _, record in ipairs(result.Records) do
			if record.State == "Slot" or record.State == "Dropped" then
				local data = util.getEggData(record)
				if data then eggs[#eggs + 1] = data end
			end
		end
	end
	table.sort(eggs, function(a, b) return a.Generation > b.Generation end)
	local filtered = state.filteredEggs
	table.clear(filtered)
	for _, egg in ipairs(eggs) do
		if util.eggMatchesRarityFilter(egg) then
			filtered[#filtered + 1] = egg
		end
	end
	state.bestEgg = filtered[1]
	state.lastRefresh = now
	return eggs
end

util.getActiveTargetEgg = function()
	if state.selectedEgg then
		for _, egg in ipairs(state.filteredEggs) do
			if egg.Uid == state.selectedEgg.Uid then
				state.selectedEgg = egg
				state.selectedUid = egg.Uid
				return egg
			end
		end
		state.selectedEgg = nil
		state.selectedUid = nil
	end
	return state.bestEgg
end

