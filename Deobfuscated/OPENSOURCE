local util = {}

util.walk = function(root, fn)
	if not root or not fn then return nil end
	local stack = root:GetChildren()
	while #stack > 0 do
		local n = #stack
		local v = stack[n]
		stack[n] = nil
		for _, child in ipairs(v:GetChildren()) do
			stack[#stack + 1] = child
		end
		if fn(v) == true then return v end
	end
	return nil
end

util.findModule = function(name)
	local found = nil
	util.walk(ReplicatedStorage, function(obj)
		if obj:IsA("ModuleScript") and obj.Name:lower() == name:lower() then
			found = obj
			return true
		end
	end)
	if found then
		local ok, result = pcall(require, found)
		if ok then return result end
	end
	return nil
end

