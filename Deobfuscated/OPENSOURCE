end

util.rarityConfigCache = {}
util.rarityColorCache = {}

util.getOfficialRarityConfig = function(arg)
	if not Rarity or not Rarity.Rarities then return nil end
	local key = string.lower(tostring(arg or "")):gsub("%s+", "")
	local cached = util.rarityConfigCache[key]
	if cached ~= nil then return cached ~= false and cached or nil end
	for k, rarity in pairs(Rarity.Rarities) do
		local k1 = string.lower(tostring(k)):gsub("%s+", "")
		local k2 = string.lower(tostring(type(rarity) == "table" and rarity.DisplayName or "")):gsub("%s+", "")
		if k1 == key or k2 == key then
			util.rarityConfigCache[key] = rarity
			return rarity
		end
	end
	util.rarityConfigCache[key] = false
	return nil
end

util.getOfficialRarityColor = function(arg)
	local key = string.lower(tostring(arg or "")):gsub("%s+", "")
	local cached = util.rarityColorCache[key]
	if cached then return cached end
	local cfg = util.getOfficialRarityConfig(key)
	local color = cfg and cfg.Color
	if typeof(color) == "ColorSequence" then
		color = color.Keypoints[1].Value
	end
	if typeof(color) ~= "Color3" then
		color = Color3.fromRGB(170, 190, 178)
	end
	util.rarityColorCache[key] = color
	return color
end

