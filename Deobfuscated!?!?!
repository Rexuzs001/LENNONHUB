UserInputService.InputChanged:Connect(function(input)
	if dragging and dragInput and input == dragInput then
		local delta = input.Position - dragStart
		panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

iconBtn.MouseEnter:Connect(function()
	TweenService:Create(iconBtn, TweenInfo.new(0.15, Enum.EasingStyle.Back), {
		Size = UDim2.fromOffset(50, 50),
	}):Play()
end)
iconBtn.MouseLeave:Connect(function()
	TweenService:Create(iconBtn, TweenInfo.new(0.15, Enum.EasingStyle.Back), {
		Size = UDim2.fromOffset(46, 46),
	}):Play()
end)

if localPlayer.Character then
	task.spawn(function()
		util.setupCharacter(localPlayer.Character)
	end)
end

localPlayer.CharacterAdded:Connect(function(char)
	util.stopNewTeleguiado()
	util.cancelEverything()
	util.setupCharacter(char)
	if state.enabled then
		task.wait(1)
		if util.canLeaveForSteal() then
			state.waitingForDay = false
			util.updateToggle()
			startGuided()
		else
			state.waitingForDay = true
			util.updateToggle()
		end
	end
end)

util.updateModeUI()
util.updateLoopUI()
util.updateToggle()
util.updateRarityChecks()

util.integrityDynamicText = {
	[toastText] = true,
	[bestName] = true,
	[bestRarity] = true,
	[bestValue] = true,
	[modeTitle] = true,
	[modeDesc] = true,
}
util.integrityDynamicTextColor = { [bestRarity] = true, [util.loopLabel] = true }
util.integrityDynamicTextTransparency = { [toastText] = true }
util.integrityDynamicBackground = {
	[modeBtn] = true,
	[util.loopBox] = true,
