	end
	local anim = char:FindFirstChild("Animate")
	if anim and anim ~= animateRef then anim:Destroy() end
	if animateRef then
		animateRef.Parent = char
		animateRef.Disabled = false
	end
	if healthRef then healthRef.Parent = char end
	if originalHum and originalBreakJoints ~= nil then
		originalHum.BreakJointsOnDeath = originalBreakJoints
