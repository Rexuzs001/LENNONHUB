end

util.startDelivery = function()
	if state.isDelivering then return end
	local groundPos = util.getGroundPosition()
	local deliverPos = util.getBossDeliveryPosition(groundPos)
	if not groundPos or not deliverPos then return end
	state.isDelivering = true
	util.clearBeam()
	util.createBeam(groundPos)
	if humanoidRootPart and humanoidRootPart.Parent then
		local look = Vector3.new(deliverPos.X - humanoidRootPart.Position.X, 0, deliverPos.Z - humanoidRootPart.Position.Z)
		if look.Magnitude > 0.01 then
			humanoidRootPart.CFrame = CFrame.lookAt(humanoidRootPart.Position, humanoidRootPart.Position + look.Unit)
		end
	end
	util.startMove(deliverPos, function()
		state.isDelivering = false
		util.cleanupBossMount()
		util.resetCarryState()
		util.completeGuidedCycle()
	end, true)
end

util.startSpammingCarry = function(uid)
	if not uid or state.isStealing then return end
	if state.carrying and state.heldEggUid == uid then return end
	state.isStealing = true
	state.lastSpamTime = 0
	task.spawn(function()
		while state.isStealing and not state.carrying do
			local now = tick()
			if now - state.lastSpamTime < CFG.SPAM_INTERVAL then
				RunService.Heartbeat:Wait()
			else
				state.lastSpamTime = now
				local ok, result = pcall(function()
					return remotes.AskFieldEggCarry:InvokeServer({ Uid = uid })
				end)
				if ok and result == true then
					state.isStealing = false
					state.carrying = true
					state.heldEggUid = uid
					state.carryLocked = true
					util.spawnBossForEgg(state.targetEgg or util.getActiveTargetEgg())
					task.spawn(function()
						util.startEggProtection(uid)
					end)
					task.spawn(function()
						local groundPos = util.getGroundPosition()
						local deliverPos = util.getBossDeliveryPosition(groundPos)
						if groundPos and deliverPos then
							state.isDelivering = true
							util.clearBeam()
							util.createBeam(groundPos)
							util.startMove(deliverPos, function()
								state.isDelivering = false
								util.cleanupBossMount()
								util.resetCarryState()
								util.completeGuidedCycle()
							end, true)
						end
					end)
					break
				else
					RunService.Heartbeat:Wait()
				end
			end
		end
		state.isStealing = false
	end)
end

util.moveToBestEggTP = function()
	if state.carrying or state.carryLocked or state.isProtecting or state.isDelivering or state.isMoving or state.isStealing then
		return false
	end
	util.refreshEggs(true)
	local egg = util.getActiveTargetEgg()
	if not egg or not humanoidRootPart or not humanoidRootPart.Parent then return false end
	if state.mode == "GUIDED" then
		state.guidedCycleActive = true
		if state.enabled then util.updateToggle() end
	end
	state.targetEgg = egg
	local pos = egg.Position
	util.createBeam(pos)
	if (pos - humanoidRootPart.Position).Magnitude <= CFG.SPAWN_OFFSET then
		util.startSpammingCarry(egg.Uid)
		return true
	end
	util.startMove(pos - (pos - humanoidRootPart.Position).Unit  CFG.SPAWN_OFFSET, function()
		if state.enabled and not state.carrying and not state.carryLocked and not state.isProtecting and not state.isDelivering and state.targetEgg and state.targetEgg.Uid == egg.Uid then
			util.startSpammingCarry(egg.Uid)
		end
	end)
	return true
end

