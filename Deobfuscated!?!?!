	local char = originalChar or localPlayer.Character
	if not char then return end
	if not originalHum then
		fakeHum = nil
		humanoid = char:FindFirstChildOfClass("Humanoid")
		local cam = workspace.CurrentCamera
		if cam and humanoid then
			cam.CameraType = Enum.CameraType.Custom
			cam.CameraSubject = humanoid
		end
		return
	end
	if jumpTrack then pcall(function() jumpTrack:Stop(0) end) end
	if jumpAnim then pcall(function() jumpAnim:Destroy() end) end
	jumpTrack = nil
	jumpAnim = nil
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local cf = hrp and hrp.CFrame or nil
	local current = char:FindFirstChildOfClass("Humanoid")
	if current and current ~= originalHum then current:Destroy() end
	if originalHum then
		originalHum.Parent = char
