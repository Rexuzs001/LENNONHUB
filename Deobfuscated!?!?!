util.setupCharacter = function(char)
	if util.motorAddedConn then util.motorAddedConn:Disconnect() util.motorAddedConn = nil end
	if util.motorRemovingConn then util.motorRemovingConn:Disconnect() util.motorRemovingConn = nil end
	characterRef = char
	humanoidRootPart = char:WaitForChild("HumanoidRootPart")
	humanoid = char:FindFirstChildOfClass("Humanoid")
	util.motorCache = {}
	util.walk(char, function(obj)
		if obj:IsA("Motor6D") then
			util.motorCache[#util.motorCache + 1] = obj
		end
	end)
	util.motorAddedConn = char.DescendantAdded:Connect(function(d)
		if d:IsA("Motor6D") then table.insert(util.motorCache, d) end
	end)
	util.motorRemovingConn = char.DescendantRemoving:Connect(function(d)
		if not d:IsA("Motor6D") then return end
		for i = #util.motorCache, 1, -1 do
			if util.motorCache[i] == d then
				table.remove(util.motorCache, i)
				break
			end
		end
	end)
end

remotes.FieldEggCarry.OnClientEvent:Connect(function(data)
	if not data or not data.Uid then return end
	local uid = data.Uid
	if data.CarrierUserId == localPlayer.UserId then
		if uid == state.heldEggUid then
			state.carrying = true
			return
		end
		if state.targetEgg and uid == state.targetEgg.Uid then
			state.carrying = true
			state.heldEggUid = uid
			state.carryLocked = true
			state.isStealing = false
			util.spawnBossForEgg(state.targetEgg or util.getActiveTargetEgg())
			task.spawn(function() util.startEggProtection(uid) end)
			task.spawn(function() util.startDelivery() end)
		end
		return
	end
	if uid == state.heldEggUid then
		state.carrying = false
		state.carryLocked = false
		if not state.isProtecting then
			task.spawn(function() util.startEggProtection(uid) end)
		end
		return
	end
	if state.targetEgg and uid == state.targetEgg.Uid then
		state.carrying = false
		if not state.isStealing then
			task.defer(function()
				task.wait(0.02)
				if state.targetEgg and state.targetEgg.Uid == uid and not state.carrying then
					util.startSpammingCarry(uid)
				end
			end)
		end
	end
end)

