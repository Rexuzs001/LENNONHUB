	util.integrityDynamicStrokeTransparency[ui.Stroke] = true
end

util.armHubIntegrity({
	gui = screenGui,
	dynamicText = util.integrityDynamicText,
	dynamicTextColor = util.integrityDynamicTextColor,
	dynamicTextTransparency = util.integrityDynamicTextTransparency,
	dynamicBackground = util.integrityDynamicBackground,
	dynamicBackgroundTransparency = util.integrityDynamicBackgroundTransparency,
	dynamicSize = util.integrityDynamicSize,
	dynamicPosition = util.integrityDynamicPosition,
	dynamicRotation = util.integrityDynamicRotation,
	dynamicStrokeColor = util.integrityDynamicStrokeColor,
	dynamicStrokeTransparency = util.integrityDynamicStrokeTransparency,
	computed = {
		{ instance = modeTitle, properties = { "Text" }, repair = util.updateModeUI },
		{
			instance = modeDesc,
			properties = { "Text" },
			repair = function()
				util.updateToggle()
				util.updateModeUI()
			end,
		},
		{ instance = bestName, properties = { "Text" }, repair = util.updateBestDisplay },
		{ instance = bestRarity, properties = { "Text", "TextColor3" }, repair = util.updateBestDisplay },
		{ instance = bestValue, properties = { "Text" }, repair = util.updateBestDisplay },
		{ instance = modeStroke, properties = { "Color" }, repair = util.updateToggle },
		{ instance = util.loopBox, properties = { "BackgroundColor3" }, repair = util.updateLoopUI },
		{ instance = util.loopBoxStroke, properties = { "Color" }, repair = util.updateLoopUI },
	},
	refresh = function()
		util.updateModeUI()
		util.updateLoopUI()
		util.updateToggle()
		util.updateRarityChecks()
		util.updateBestDisplay()
	end,
