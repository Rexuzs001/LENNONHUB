	util.integrityWatchComputed(ui.NameLabel, { "Text" }, util.refreshDropdownRows)
	util.integrityWatchComputed(ui.RarityLabel, { "Text", "TextColor3" }, util.refreshDropdownRows)
	util.integrityWatchComputed(ui.ValueLabel, { "Text" }, util.refreshDropdownRows)
end
for _, ui in pairs(rarityChecks) do
	util.integrityWatchComputed(ui.Box, { "Text", "TextColor3", "BackgroundColor3", "BackgroundTransparency" }, util.updateRarityChecks)
	util.integrityWatchComputed(ui.Stroke, { "Color", "Transparency" }, util.updateRarityChecks)
end

