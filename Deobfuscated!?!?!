local util = {}

util.walk = function(root, fn)
	if not root or not fn then return nil end
	local stack = root:GetChildren()
	while #stack > 0 do
		local n = #stack
		local v = stack[n]
		stack[n] = nil
		local kids = v:GetChildren()
		for i = 1, #kids do
			stack[#stack + 1] = kids[i]
		end
		if fn(v) == true then
			return v
		end
	end
	return nil
end

util.snapshot = function(root)
	local out = {}
	util.walk(root, function(obj)
		out[#out + 1] = obj
	end)
	return out
end

util.Integrity = {
	armed = false,
	restoring = false,
	connections = {},
	records = {},
	knownRootChildren = {},
	repairQueued = false,
	hardUntil = 0,
	hardRefreshAt = 0,
	tamperCount = 0,
	tamperWindow = 0,
	guardName = "LHVisualGuard_" .. tostring(math.random(100000, 999999)),
}

util.integrityDisconnect = function()
	local integrity = util.Integrity
	for i = 1, #integrity.connections do
		local c = integrity.connections[i]
		if c then
			pcall(function()
				c:Disconnect()
			end)
		end
	end
	table.clear(integrity.connections)
	pcall(function()
		RunService:UnbindFromRenderStep(integrity.guardName)
	end)
end

util.integrityEscalate = function()
	local integrity = util.Integrity
	local now = os.clock()
	if now - integrity.tamperWindow > 0.45 then
		integrity.tamperWindow = now
		integrity.tamperCount = 0
	end
	integrity.tamperCount = integrity.tamperCount + 1
	if integrity.tamperCount >= 3 then
		integrity.hardUntil = math.max(integrity.hardUntil, now + 2.5)
	end
end

util.integrityRepairRecord = function(rec, prop)
	local inst = rec and rec.instance
	if not inst then return end
	if rec.parent and inst.Parent ~= rec.parent then
		pcall(function()
			inst.Parent = rec.parent
		end)
	end
	if prop then
		local val = rec.properties[prop]
		if val ~= nil then
			local ok, cur = pcall(function()
				return inst[prop]
			end)
			if ok and cur ~= val then
				pcall(function()
					inst[prop] = val
				end)
			end
		end
		return
	end
	for k, property in pairs(rec.properties) do
		local ok, cur = pcall(function()
			return inst[k]
		end)
		if ok and cur ~= property then
			pcall(function()
				inst[k] = property
			end)
		end
	end
end

util.integrityQueueRepair = function()
	local integrity = util.Integrity
	if not integrity.armed or integrity.restoring or integrity.repairQueued then return end
	integrity.repairQueued = true
	task.defer(function()
		integrity.repairQueued = false
		util.integrityRepairAll()
	end)
end

util.integrityRepairAll = function()
	local integrity = util.Integrity
	if not integrity.armed or integrity.restoring then return end
	integrity.restoring = true
	for i = 1, #integrity.records do
		util.integrityRepairRecord(integrity.records[i])
	end
	if integrity.refresh then
		pcall(integrity.refresh)
	end
	integrity.restoring = false
end

util.integrityWatch = function(inst, props, parent)
	if not inst then return end
	local integrity = util.Integrity
	local rec = { instance = inst, properties = props, parent = parent }
	integrity.records[#integrity.records + 1] = rec
	if parent then
		integrity.connections[#integrity.connections + 1] = inst.AncestryChanged:Connect(function()
			if not integrity.armed or integrity.restoring or inst.Parent == parent then return end
			util.integrityEscalate()
			integrity.restoring = true
			pcall(function()
				inst.Parent = parent
			end)
			integrity.restoring = false
			if inst.Parent ~= parent then
				util.integrityQueueRepair()
			end
		end)
	end
	integrity.connections[#integrity.connections + 1] = inst.Changed:Connect(function(prop)
		if not integrity.armed or integrity.restoring or props[prop] == nil then return end
		local ok, cur = pcall(function()
			return inst[prop]
		end)
		if ok and cur == props[prop] then return end
		util.integrityEscalate()
		integrity.restoring = true
		util.integrityRepairRecord(rec, prop)
		integrity.restoring = false
	end)
end

util.integrityWatchComputed = function(inst, props, repair)
	if not inst or not repair then return end
	local integrity = util.Integrity
	local map = {}
	for i = 1, #props do
		map[props[i]] = true
	end
	integrity.connections[#integrity.connections + 1] = inst.Changed:Connect(function(prop)
		if not integrity.armed or integrity.restoring or not map[prop] then return end
		util.integrityEscalate()
		integrity.restoring = true
		pcall(repair)
		integrity.restoring = false
	end)
end

util.armHubIntegrity = function(cfg)
	local integrity = util.Integrity
	util.integrityDisconnect()
	integrity.armed = false
	integrity.restoring = false
	integrity.repairQueued = false
	integrity.records = {}
	integrity.knownRootChildren = {}
	integrity.hardUntil = 0
	integrity.hardRefreshAt = 0
	integrity.tamperCount = 0
	integrity.tamperWindow = os.clock()
	local gui = cfg.gui
	if not gui or not gui.Parent then return end

	local dynText = cfg.dynamicText or {}
	local dynTextColor = cfg.dynamicTextColor or {}
	local dynTextTrans = cfg.dynamicTextTransparency or {}
	local dynBg = cfg.dynamicBackground or {}
	local dynBgTrans = cfg.dynamicBackgroundTransparency or {}
	local dynSize = cfg.dynamicSize or {}
	local dynPos = cfg.dynamicPosition or {}
	local dynRot = cfg.dynamicRotation or {}
	local dynStrokeColor = cfg.dynamicStrokeColor or {}
	local dynStrokeTrans = cfg.dynamicStrokeTransparency or {}

	local function capture(obj)
		local t = { Name = obj.Name }
		if obj:IsA("ScreenGui") then
			t.ResetOnSpawn = obj.ResetOnSpawn
			t.IgnoreGuiInset = obj.IgnoreGuiInset
			t.DisplayOrder = obj.DisplayOrder
			t.AutoLocalize = obj.AutoLocalize
			t.ZIndexBehavior = obj.ZIndexBehavior
		end
		if obj:IsA("GuiObject") then
			t.BorderSizePixel = obj.BorderSizePixel
			t.ZIndex = obj.ZIndex
			t.AnchorPoint = obj.AnchorPoint
			if not dynSize[obj] then t.Size = obj.Size end
			if not dynPos[obj] then t.Position = obj.Position end
			if not dynRot[obj] then t.Rotation = obj.Rotation end
			if not dynBg[obj] then t.BackgroundColor3 = obj.BackgroundColor3 end
			if not dynBgTrans[obj] then t.BackgroundTransparency = obj.BackgroundTransparency end
		end
		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			if not dynText[obj] then t.Text = obj.Text end
			if not dynTextColor[obj] then t.TextColor3 = obj.TextColor3 end
			if not dynTextTrans[obj] then t.TextTransparency = obj.TextTransparency end
			t.TextStrokeColor3 = obj.TextStrokeColor3
			t.TextStrokeTransparency = obj.TextStrokeTransparency
			t.TextSize = obj.TextSize
			t.Font = obj.Font
			t.TextXAlignment = obj.TextXAlignment
			t.TextYAlignment = obj.TextYAlignment
			t.TextWrapped = obj.TextWrapped
			t.TextScaled = obj.TextScaled
			t.TextTruncate = obj.TextTruncate
			if obj:IsA("TextButton") then
				t.AutoButtonColor = obj.AutoButtonColor
			end
		end
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			t.Image = obj.Image
			t.ImageColor3 = obj.ImageColor3
			t.ImageTransparency = obj.ImageTransparency
			t.ScaleType = obj.ScaleType
			if obj:IsA("ImageButton") then
				t.AutoButtonColor = obj.AutoButtonColor
			end
		end
		if obj:IsA("UIStroke") then
			if not dynStrokeColor[obj] then t.Color = obj.Color end
			if not dynStrokeTrans[obj] then t.Transparency = obj.Transparency end
			t.Thickness = obj.Thickness
			t.LineJoinMode = obj.LineJoinMode
		end
		if obj:IsA("UICorner") then t.CornerRadius = obj.CornerRadius end
		if obj:IsA("UIScale") then t.Scale = obj.Scale end
		if obj:IsA("UIGradient") then
			t.Color = obj.Color
			t.Transparency = obj.Transparency
			t.Rotation = obj.Rotation
		end
		return t
	end

	local parent = gui.Parent
	util.integrityWatch(gui, capture(gui), parent)
	local children = gui:GetChildren()
	for i = 1, #children do
		integrity.knownRootChildren[children[i]] = true
	end
	util.walk(gui, function(obj)
		util.integrityWatch(obj, capture(obj), obj.Parent)
	end)

	integrity.connections[#integrity.connections + 1] = gui.ChildAdded:Connect(function(child)
		if not integrity.armed or integrity.restoring then return end
		if not integrity.knownRootChildren[child] then
			util.integrityEscalate()
			pcall(function()
				child:Destroy()
			end)
		end
	end)

	integrity.connections[#integrity.connections + 1] = gui.ChildRemoved:Connect(function(child)
		if not integrity.armed or integrity.restoring or not integrity.knownRootChildren[child] then return end
		util.integrityEscalate()
		util.integrityQueueRepair()
	end)

	local computed = cfg.computed or {}
	for i = 1, #computed do
		local c = computed[i]
		util.integrityWatchComputed(c.instance, c.properties, c.repair)
	end

	integrity.refresh = cfg.refresh
	integrity.armed = true
	util.integrityRepairAll()

	pcall(function()
		RunService:UnbindFromRenderStep(integrity.guardName)
	end)

	RunService:BindToRenderStep(integrity.guardName, Enum.RenderPriority.Last.Value + 1000, function()
		local now = os.clock()
		if not integrity.armed or integrity.restoring or now > integrity.hardUntil then return end
		integrity.restoring = true
		for i = 1, #integrity.records do
			util.integrityRepairRecord(integrity.records[i])
		end
		if integrity.refresh and now >= integrity.hardRefreshAt then
			integrity.hardRefreshAt = now + 0.05
			pcall(integrity.refresh)
		end
		integrity.restoring = false
	end)
end

util.findModule = function(name)
	local found = nil
	util.walk(ReplicatedStorage, function(obj)
		if obj:IsA("ModuleScript") and obj.Name:lower() == name:lower() then
			found = obj
			return true
		end
	end)
	if found then
		local ok, result = pcall(require, found)
		if ok then return result end
	end
	return nil
end

