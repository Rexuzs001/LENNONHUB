util.applyZombieDesync = function(char)
	if not char then return nil end
	if fakeHum and fakeHum.Parent == char then return fakeHum end
	savedWalkSpeed = nil
	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local cf = hrp and hrp.CFrame or nil
	local hip = hum.HipHeight
	originalHum = hum
	originalBreakJoints = hum.BreakJointsOnDeath
	originalChar = char
	healthRef = char:FindFirstChild("Health")
	animateRef = char:FindFirstChild("Animate")
	local clone = util.createZombieHumanoidClone(hum, true)
	if not clone then return nil end
	if animateRef then animateRef.Parent = nil end
	local animator = clone:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = clone
	end
	if CFG.JUMP_ANIMATION_ID and CFG.JUMP_ANIMATION_ID ~= "" then
		pcall(function()
			jumpAnim = Instance.new("Animation")
			jumpAnim.AnimationId = CFG.JUMP_ANIMATION_ID
			jumpTrack = animator:LoadAnimation(jumpAnim)
			clone.Jumping:Connect(function(active)
				if active and jumpTrack then jumpTrack:Play() end
			end)
		end)
	end
	hum.Parent = nil
	clone.Parent = char
	clone.HipHeight = hip
	fakeHum = clone
	humanoid = clone
	if animateRef then
		if not pcall(function()
			local c = animateRef:Clone()
			c.Name = "Animate"
			c.Parent = char
			c.Disabled = false
		end) then
			animateRef.Parent = char
			animateRef.Disabled = false
		end
	end
	util.applyAntiRagdoll(char, clone)
	if hrp and hrp.Parent then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		if cf then hrp.CFrame = cf end
	end
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Custom
		cam.CameraSubject = clone
	end
	return clone
end

