util.loadBossMovementSounds = function(model)
	bossSounds = {}
	local preferred, all = {}, {}
	util.walk(model, function(obj)
		if obj:IsA("Sound") then
			all[#all + 1] = obj
			local n = string.lower(obj.Name)
			if n:find("walk") or n:find("run") or n:find("move") or n:find("step") or obj.Looped then
				preferred[#preferred + 1] = obj
			end
		end
	end)
	if #preferred == 0 then preferred = all end
	for _, sound in ipairs(preferred) do
		table.insert(bossSounds, { Sound = sound, Looped = sound.Looped })
		sound.Looped = true
	end
end

util.setBossMovementSounds = function(playing)
	for _, entry in ipairs(bossSounds) do
		local sound = entry.Sound
		if sound and sound.Parent then
			if playing then
				if not sound.IsPlaying then
					pcall(function() sound:Play() end)
				end
			elseif sound.IsPlaying then
				pcall(function() sound:Stop() end)
			end
		end
	end
end

util.loadBossAnimations = function(model, areaName)
	util.loadBossMovementSounds(model)
	local controller = model:FindFirstChildWhichIsA("AnimationController", true)
	if not controller then
		controller = Instance.new("AnimationController")
		controller.Name = "AnimationController"
		controller.Parent = model:FindFirstChild("Model") or model
	end
	local animator = controller:FindFirstChildWhichIsA("Animator") or Instance.new("Animator")
	animator.Parent = controller
	local idleId, walkId = nil, nil
	pcall(function()
		local cfg = ReplicatedStorage.Data.Guards.Configs:FindFirstChild(areaName)
		if cfg then
			local module = require(cfg)
			idleId = module.IdleAnimation and module.IdleAnimation.AnimationId
			walkId = module.WalkAnimation and module.WalkAnimation.AnimationId
		end
	end)
	local function loadTrack(id, priority)
		if not id then return nil end
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if not ok or not track then return nil end
		track.Looped = true
		track.Priority = priority
		return track
	end
	bossIdleTrack = loadTrack(idleId, Enum.AnimationPriority.Idle)
	bossWalkTrack = loadTrack(walkId, Enum.AnimationPriority.Movement)
	if bossIdleTrack then bossIdleTrack:Play(0.15) end
	local hum = fakeHum or (characterRef and characterRef:FindFirstChildOfClass("Humanoid"))
	if hum then
		local anim = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator")
		anim.Parent = hum
		local a = Instance.new("Animation")
		a.AnimationId = "rbxassetid://2506281703"
		local ok, track = pcall(function()
			return anim:LoadAnimation(a)
		end)
		if ok and track then
			bossRiderTrack = track
			bossRiderTrack.Looped = true
			bossRiderTrack.Priority = Enum.AnimationPriority.Action4
			bossRiderTrack:Play(0.15)
			bossRiderTrack:AdjustWeight(1, 0.1)
		end
	end
	local t = 0
	bossAnimConn = RunService.Heartbeat:Connect(function(dt)
		t += dt
		if t < 0.08 then return end
		t = 0
		if not bossModel or not bossModel.Parent then
			util.cleanupBossMount()
			return
		end
		local moving = state.isMoving
		if moving and bossWalkTrack then
			if bossIdleTrack and bossIdleTrack.IsPlaying then bossIdleTrack:Stop(0.15) end
			if not bossWalkTrack.IsPlaying then bossWalkTrack:Play(0.15) end
			util.setBossMovementSounds(true)
		elseif not moving and bossIdleTrack then
			if bossWalkTrack and bossWalkTrack.IsPlaying then bossWalkTrack:Stop(0.15) end
			if not bossIdleTrack.IsPlaying then bossIdleTrack:Play(0.15) end
			util.setBossMovementSounds(false)
		else
			util.setBossMovementSounds(moving)
		end
		if bossRiderTrack and not bossRiderTrack.IsPlaying then
			bossRiderTrack:Play(0.1)
			bossRiderTrack:AdjustWeight(1, 0.1)
		end
	end)
end

util.getGroundDirectionFrom = function(from)
	local ground = workspace:FindFirstChild("OBJECTS")
		and workspace.OBJECTS:FindFirstChild("Areas")
		and workspace.OBJECTS.Areas:FindFirstChild("Ground")
	if not ground then return nil end
	local pos
	if ground:IsA("Model") then
		pos = ground:GetPivot().Position
	elseif ground:IsA("BasePart") then
		pos = ground.Position
	else
		local part = ground:FindFirstChildWhichIsA("BasePart", true)
		pos = part and part.Position
	end
	if not pos then return nil end
	local dir = Vector3.new(pos.X - from.X, 0, pos.Z - from.Z)
	return dir.Magnitude > 0.01 and dir.Unit or nil
end

util.spawnBossForEgg = function(egg)
	util.cleanupBossMount()
	if not humanoidRootPart or not humanoidRootPart.Parent then return nil end
	local areaName = util.getBossAreaFromEgg(egg)
	local guardFolder = areaName and guardAreas:FindFirstChild(areaName)
	local guard = guardFolder and guardFolder:FindFirstChild("Guard")
	if not guard then
		warn("Guard not found for egg area:", tostring(areaName))
		return nil
	end
	local primary = guard.PrimaryPart
		or guard:FindFirstChild("HumanoidRootPart", true)
		or guard:FindFirstChild("Root", true)
		or guard:FindFirstChildWhichIsA("BasePart", true)
	if not primary then return nil end
	bossY = primary.Position.Y
	local clone = guard:Clone()
	clone.Name = "Boss_" .. tostring(areaName)
	bossSource = guard
	bossSourceParent = guard.Parent
	guard.Parent = nil
	local root = clone.PrimaryPart
		or clone:FindFirstChild("HumanoidRootPart", true)
		or clone:FindFirstChild("Root", true)
		or clone:FindFirstChildWhichIsA("BasePart", true)
	if not root then
		clone:Destroy()
		if bossSource and bossSourceParent then bossSource.Parent = bossSourceParent end
		bossSource = nil
		bossSourceParent = nil
		return nil
	end
	clone.PrimaryPart = root
	util.walk(clone, function(obj)
		if obj:IsA("BasePart") then
			obj.CanCollide = false
			obj.CanQuery = false
			obj.CanTouch = false
			obj.Massless = true
			obj.Anchored = false
		end
	end)
	local look = util.getGroundDirectionFrom(humanoidRootPart.Position) or humanoidRootPart.CFrame.LookVector
	local unit = Vector3.new(look.X, 0, look.Z).Unit
	local spawnPos = Vector3.new((humanoidRootPart.Position + unit  8).X, bossY, (humanoidRootPart.Position + unit  8).Z)
	clone:PivotTo(CFrame.lookAt(spawnPos, spawnPos + unit))
	local dy = bossY - root.Position.Y
	if math.abs(dy) > 0.001 then
		clone:PivotTo(clone:GetPivot() + Vector3.new(0, dy, 0))
	end
	clone.Parent = workspace
	root.Anchored = true
	local off = bossOffsets[areaName] or { X = 0, Y = 3, Z = 0 }
	bossOffset = off
	humanoidRootPart.CFrame = root.CFrame  CFrame.new(off.X, off.Y, off.Z)
	root.Anchored = false
	bossWeld = Instance.new("WeldConstraint")
	bossWeld.Name = "BossRiderWeld"
	bossWeld.Part0 = humanoidRootPart
	bossWeld.Part1 = root
	bossWeld.Parent = humanoidRootPart
	bossModel = clone
	bossRoot = root
	local hum = fakeHum or (characterRef and characterRef:FindFirstChildOfClass("Humanoid"))
	if hum then
		hum.PlatformStand = false
		hum.AutoRotate = false
	end
	util.loadBossAnimations(clone, areaName)
	return clone
end

util.getBossDeliveryPosition = function(pos)
	if typeof(pos) ~= "Vector3" then return pos end
	local off = bossOffset
	if not off then return pos end
	local base = Vector3.new(pos.X, bossY or pos.Y, pos.Z)
	return (CFrame.lookAt(base, base + (util.getGroundDirectionFrom(base) or Vector3.new(0, 0, -1)))  CFrame.new(off.X, off.Y, off.Z)).Position
end

