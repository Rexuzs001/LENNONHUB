util.isStartWallOpen = function()
	local objects = workspace:FindFirstChild("OBJECTS")
	local areas = objects and objects:FindFirstChild("Areas")
	if not areas then return true end
	local wallStartVisual = areas:FindFirstChild("WallStartVisual")
	if wallStartVisual and wallStartVisual:IsA("BasePart") and wallStartVisual.Size.Y > 0.25 then
		return false
	end
	local wallStartCollision = areas:FindFirstChild("WallStartCollision")
	if wallStartCollision and wallStartCollision:IsA("BasePart") and wallStartCollision.CanCollide then
		return false
	end
	return true
