util.getAreaCenter = function(area)
	if not area then return nil end
	if area:IsA("Model") then return area:GetPivot().Position end
	if area:IsA("BasePart") then return area.Position end
	local part = area:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position or nil
end

util.isPositionInsideArea = function(pos, area)
	if not area then return false end
	local bb, size
	if area:IsA("Model") then
		bb, size = area:GetBoundingBox()
	elseif area:IsA("BasePart") then
		bb = area.CFrame
		size = area.Size
	else
		return false
	end
	local localPos = bb:PointToObjectSpace(pos)
	return math.abs(localPos.X) <= size.X / 2
		and math.abs(localPos.Z) <= size.Z / 2
		and math.abs(localPos.Y) <= size.Y / 2 + 100
end

util.getBossAreaFromEgg = function(egg)
	if not egg then return nil end
	local areaName = egg.AreaName or egg.Area or egg.World or egg.Biome
	if type(areaName) == "string" and guardAreas:FindFirstChild(areaName) then
		return areaName
	end
	local pos = egg.Position
	if typeof(pos) ~= "Vector3" then return nil end
	local closestDist, closestName = nil, nil
	for _, child in ipairs(guardAreas:GetChildren()) do
		if util.isPositionInsideArea(pos, child) then
			return child.Name
		end
		local center = util.getAreaCenter(child)
		if center then
			local dist = (Vector3.new(center.X, 0, center.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude
			if not closestDist or dist < closestDist then
				closestName = child.Name
				closestDist = dist
			end
		end
	end
	return closestName
end

util.stopBossAnimations = function()
	if bossAnimConn then
		bossAnimConn:Disconnect()
		bossAnimConn = nil
	end
	if bossIdleTrack then pcall(function() bossIdleTrack:Stop(0.15) end) end
	if bossWalkTrack then pcall(function() bossWalkTrack:Stop(0.15) end) end
	if bossRiderTrack then pcall(function() bossRiderTrack:Stop(0.15) end) end
	for _, entry in ipairs(bossSounds) do
		local sound = entry.Sound
		if sound and sound.Parent then
			pcall(function()
				sound:Stop()
				sound.Looped = entry.Looped
			end)
		end
	end
	bossSounds = {}
	bossIdleTrack = nil
	bossWalkTrack = nil
	bossRiderTrack = nil
end

