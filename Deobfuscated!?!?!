util.isPlayerInGroundArea = function(hrp)
	local ground = workspace:FindFirstChild("OBJECTS")
		and workspace.OBJECTS:FindFirstChild("Areas")
		and workspace.OBJECTS.Areas:FindFirstChild("Ground")
	if not ground then return false end
	if ground:IsA("Model") then
		local bb, size = ground:GetBoundingBox()
		local localPos = bb:PointToObjectSpace(hrp.Position)
		return math.abs(localPos.X) <= size.X / 2
			and math.abs(localPos.Y) <= size.Y / 2 + 20
			and math.abs(localPos.Z) <= size.Z / 2
	end
	if ground:IsA("BasePart") then
		local localPos = ground.CFrame:PointToObjectSpace(hrp.Position)
		return math.abs(localPos.X) <= ground.Size.X / 2
			and math.abs(localPos.Y) <= ground.Size.Y / 2 + 20
			and math.abs(localPos.Z) <= ground.Size.Z / 2
	end
	return false
end

