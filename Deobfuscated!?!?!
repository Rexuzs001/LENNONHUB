util.getGroundAdjustedPosition = function(pos)
	if typeof(pos) ~= "Vector3" then return pos end
	local clearance = tonumber(CFG.GROUND_CLEARANCE) or 4
	local char = localPlayer.Character or characterRef
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local lift
	if hrp and hum then
		lift = math.max(clearance, hrp.Size.Y  0.5 + math.max(tonumber(hum.HipHeight) or 0, 0) + 0.2)
	else
		lift = clearance
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	local filter = {}
	if characterRef and characterRef.Parent then
		table.insert(filter, characterRef)
	end
	local origin = pos + Vector3.new(0, CFG.RAYCAST_UP, 0)
	local dir = Vector3.new(0, -(CFG.RAYCAST_UP + CFG.RAYCAST_DOWN), 0)
	for _ = 1, 8 do
		params.FilterDescendantsInstances = filter
		local hit = workspace:Raycast(origin, dir, params)
		if not hit then return pos end
		local inst = hit.Instance
		if inst:IsA("Terrain") or (inst:IsA("BasePart") and inst.CanCollide) then
			return Vector3.new(pos.X, hit.Position.Y + lift, pos.Z)
		end
		table.insert(filter, inst)
	end
	return pos
end

util.stopCurrentTween = function(dropEgg)
	if tweenConn then
		tweenConn:Disconnect()
		tweenConn = nil
	end
	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end
	local char = localPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	util.restoreWalkSpeed()
	if dropEgg then
		task.spawn(function()
			task.wait(0.05)
			pcall(function()
				if remotes.AskFieldEggDrop then
					remotes.AskFieldEggDrop:InvokeServer({ Reason = "PlayerRequest" })
				end
			end)
		end)
	end
end

