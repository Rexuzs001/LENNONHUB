	state.lastProtectTime = 0
	task.spawn(function()
		while state.isProtecting and state.heldEggUid == uid do
			state.lastProtectTime = tick()
			local ok, result = pcall(function()
				return remotes.AskFieldEggCarry:InvokeServer({ Uid = uid })
			end)
			if ok and result == true then
				state.carrying = true
			end
			task.wait(CFG.PROTECT_INTERVAL)
		end
	end)
end

