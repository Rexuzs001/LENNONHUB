util.formatNumber = function(n)
	n = tonumber(n) or 0
	local function trim(x)
		return (string.format("%.2f", x):gsub("(%..-)0+\( ", "%1"):gsub("%. \)", ""))
	end
	local abs = math.abs(n)
	for _, pair in ipairs({ { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
		if abs >= pair[1] then
			return trim(n / pair[1]) .. pair[2]
		end
	end
	return tostring(math.floor(n + 0.5))
end

util.getScaleMultiplier = function(scaleVal)
	local n = tonumber(scaleVal) or 1
	if n <= 5 then return n ^ 1.85 end
	return (n / 5) ^ 1.2  19.637875755794113
end

util.getEggData = function(record)
	local dir = Assets.Directory[record.AssetCategory]
	if not dir then return nil end
	local rate = tonumber(dir.EarningRate) or 0
	local scaleVal = tonumber(record.AssetScale) or 1
	local mutMul = 1
	if record.Mutations and #record.Mutations > 0 and type(Mutations.EarningsFor) == "function" then
		local ok, result = pcall(function()
			return Mutations.EarningsFor(record.Mutations)
		end)
		if ok then mutMul = tonumber(result) or 1 end
	end
	local gen = rate  util.getScaleMultiplier(scaleVal)  mutMul
	local color = Color3.fromRGB(170, 190, 178)
	local rarityNum = 0
	local rarityName = ""
	if dir.Rarity then
		rarityNum = dir.Rarity.RarityNumber or 0
		rarityName = dir.Rarity.DisplayName or dir.Rarity.Name or ""
		color = util.getOfficialRarityColor(rarityName)
	end
	return {
		Uid = record.Uid,
		Category = record.AssetCategory,
		Name = dir.DisplayName or record.AssetCategory,
		Generation = math.round(gen),
		Position = record.BottomCFrame.Position,
		BottomCFrame = record.BottomCFrame,
		Rarity = rarityNum,
		RarityName = rarityName,
		RarityColor = color,
		BaseRate = rate,
		Scale = scaleVal,
	}
end

util.getGroundPosition = function()
	local objects = workspace:FindFirstChild("OBJECTS")
	if not objects then return nil end
	local areas = objects:FindFirstChild("Areas")
	if not areas then return nil end
	local ground = areas:FindFirstChild("Ground")
	if not ground then return nil end
	if ground:IsA("BasePart") then
		return ground.Position + Vector3.new(0, ground.Size.Y  0.5 + CFG.GROUND_OFFSET, 0)
	end
	if ground:IsA("Model") then
		local pivot = ground:GetPivot()
		local _, size = ground:GetBoundingBox()
		return pivot.Position + Vector3.new(0, size.Y  0.5 + CFG.GROUND_OFFSET, 0)
